# =====================================================
# Migo Environment Variables
# =====================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# =====================================================

# ─── Supabase ───
# Required. Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Google Gemini AI ───
# Required for summarization, quiz generation, and AI features.
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: Override the default Gemini model (default: gemini-2.0-flash)
# The system automatically falls back to gemini-1.5-flash and gemini-1.5-pro
# if the primary model is unavailable.
# GEMINI_MODEL=gemini-2.0-flash

# ─── Push Notifications (optional) ───
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Chat Service (optional) ───
# NEXT_PUBLIC_CHAT_SERVICE_URL=your_chat_service_url
