# =====================================================
# Migo Environment Variables
# =====================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# =====================================================

# ─── Supabase ───
# Required. Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Groq AI (PRIMARY provider) ───
# Required for summarization, quiz generation, and AI features.
# Groq provides ultra-fast inference using LPU hardware.
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional: Override the default Groq model (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, llama-3.2-90b-vision-preview
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Push Notifications (optional) ───
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Chat Service (optional) ───
# NEXT_PUBLIC_CHAT_SERVICE_URL=your_chat_service_url
