# =====================================================
# Migo Environment Variables
# =====================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# =====================================================

# ─── Supabase ───
# Required. Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Google Gemini AI (PRIMARY provider) ───
# Required for summarization, quiz generation, and AI features.
# Get your API keys from https://aistudio.google.com/apikey
# Multiple keys rotate automatically with health scoring and failover.
GOOGLE_API_KEY_1=your_google_api_key_1
# GOOGLE_API_KEY_2=your_google_api_key_2
# GOOGLE_API_KEY_3=your_google_api_key_3
# Up to GOOGLE_API_KEY_9 supported

# ─── Cerebras AI (FALLBACK provider — optional) ───
# Used when all Gemini keys are unavailable.
# Get your API key from https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=your_cerebras_api_key

# ─── OpenRouter AI (FALLBACK provider — optional) ───
# Last resort before graceful failure. Uses free models.
# Get your API key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key

# ─── Push Notifications (optional) ───
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Chat Service (optional) ───
# NEXT_PUBLIC_CHAT_SERVICE_URL=your_chat_service_url

# ─── Socket.IO Internal API (for server-to-server emit) ───
# Shared secret between Next.js API routes and the Socket.IO server.
# EMIT_SECRET=attendo-internal-2024
