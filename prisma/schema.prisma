// =====================================================
// NOTE: This project uses Supabase (PostgreSQL) directly
// via the Supabase JS client, not Prisma ORM.
//
// The database schema is defined in:
//   - supabase/COMPLETE_SCHEMA.sql
//   - supabase/migrations/
//
// Do NOT add models here. This file exists only because
// Prisma is installed as a dependency for potential future
// use or tooling compatibility.
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
